# Keeps the Docker build context small and fast (the context is the repo root).
# Only the requirements files, src/, frontend/ (the research studio's, the
# writing page's and the Chronos workspace's sources, compiled in a build stage)
# and the GPU worker's contract are needed to build the images; everything
# below is excluded.

# Version control
.git
.gitignore

# Local secrets — must never enter the build context or image layers. Patterns
# here are anchored at the context root, so `.env` alone would miss nested ones
# (docker/gpubox/.env holds the GPU box's token).
docker/.env
.env
**/.env

# Python caches / build artifacts
**/__pycache__/
**/*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Not needed to build or run the app image
tests/
docs/
# ...except the contract the GPU worker enforces at runtime (Dockerfile.worker).
!docs/gpu_worker/openapi.json

# The frontend: the images build it from source (package files and src/ only),
# so local dependencies and a local build never enter the context.
frontend/node_modules/
src/visualizer/akasha/static/studio/
src/visualizer/logos/static/writer/
src/visualizer/chronos/static/workspace/

# Virtualenvs
.venv/
venv/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
*.swp
