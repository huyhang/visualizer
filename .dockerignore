# Keeps the Docker build context small and fast (the context is the repo root).
# Only requirements.txt, src/, and docker/environment.yaml are needed to build
# the images; everything below is excluded.

# Version control
.git
.gitignore

# Local secrets — must never enter the build context or image layers
docker/.env
.env

# Python caches / build artifacts
**/__pycache__/
**/*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Not needed to build or run the app image
tests/
graph_schema/

# Virtualenvs
.venv/
venv/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
*.swp
