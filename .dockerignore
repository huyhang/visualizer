# Keeps the Docker build context small and fast (the context is the repo root).
# Only the requirements files, src/ and the GPU worker's contract are needed to
# build the images; everything below is excluded.

# Version control
.git
.gitignore

# Local secrets — must never enter the build context or image layers. Patterns
# here are anchored at the context root, so `.env` alone would miss nested ones
# (docker/gpubox/.env holds the GPU box's token).
docker/.env
.env
**/.env

# Python caches / build artifacts
**/__pycache__/
**/*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Not needed to build or run the app image
tests/
docs/
# ...except the contract the GPU worker enforces at runtime (Dockerfile.worker).
!docs/gpu_worker/openapi.json

# Virtualenvs
.venv/
venv/

# Editor / OS cruft
.DS_Store
.idea/
.vscode/
*.swp
