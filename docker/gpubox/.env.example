# Copy to docker/gpubox/.env (git-ignored, auto-loaded by compose) and fill in.

# Required. The NAS sends this as its bearer token: put the same value in the
# visualizer's docker/.env as GPU_WORKER_TOKEN.   openssl rand -hex 32
WORKER_TOKEN=

# Required. SearXNG's own secret; nothing else uses it.   openssl rand -hex 32
SEARXNG_SECRET=

# Optional -- the defaults suit the box described in the notes.
# WORKER_BIND=127.0.0.1:8700        # keep it on localhost; tailscale serve exposes it
# OLLAMA_URL=http://127.0.0.1:11434
# RESEARCH_MODEL=qwen3:30b          # start with one model for both: a swap costs 10-30 s
# REVIEW_MODEL=qwen3:30b
# QUEUE_MAX=20
# RESULT_TTL_HOURS=24               # results (and nothing else) are kept this long
# PLAN_TTL_HOURS=24                 # a research plan awaiting approval fails after this
# NUM_CTX=32768                     # model context per request; more costs VRAM
# LLM_TIMEOUT=300                   # seconds for one model call
# FETCH_TIMEOUT=15                  # seconds per web page
# FETCH_MAX_BYTES=5242880           # 5 MB per web page
# IMAGE_MAX_BYTES=20971520          # 20 MB per image: Akasha's own upload cap

# Signs image candidates so callers can only fetch images the worker found.
# Leave unset: a key is generated in the worker-data volume and kept there.
# Setting (or changing) it invalidates every token handed out so far.
# WORKER_SIGNING_KEY=

# Optional second checker, e.g. the M1 Max's Ollama over Tailscale. Leave empty
# to run without it; results then say they were not second-checked.
# VERIFIER_URL=http://<mac-tailscale-name>:11434
# VERIFIER_RESEARCH_MODEL=bespoke-minicheck
# VERIFIER_REVIEW_MODEL=gemma3:27b
