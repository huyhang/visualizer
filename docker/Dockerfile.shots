# The screenshot job: every screen the browser smoke scripts walk, photographed
# in a throwaway copy of the stack. Built and run by
# docker/docker-compose.screenshots.yml -- on a laptop, in CI, or on the NAS --
# and driven by docker/shots.py.
#
# Not the production image. It adds a browser, mongomock and the scripts under
# docker/, and runs the dev server rather than gunicorn: an in-memory database,
# so a run cannot reach real data, and the fake GPU box, so research and LLM
# review can be photographed without the box.
#
# Build context is the repo root.

# The compiled surfaces, built exactly as docker/Dockerfile builds them.
FROM node:22-slim AS bundles
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

# Bookworm rather than the floating slim tag: Playwright's --with-deps knows
# exactly which packages Debian 12 needs.
FROM python:3.11-slim-bookworm

WORKDIR /app

# Fonts are part of the picture. The pages ask for the system UI face and for
# Georgia, and a bare image has only DejaVu, which would set every screenshot
# in it. Inter stands in for the UI face and Noto Serif for Georgia;
# Liberation supplies the metric-compatible Times the print stylesheet expects,
# as it does in the production image. shots-fonts.conf tells fontconfig.
RUN apt-get update && apt-get install -y --no-install-recommends \
    fontconfig fonts-inter fonts-noto-core fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Playwright at the version the smoke scripts name; mongomock is the dev
# server's database.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt "mongomock>=4.1" playwright==1.62.0 \
    && playwright install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/*

# After the browser, which brings fonts of its own, and so that tuning this
# file does not download Chromium again.
COPY docker/shots-fonts.conf /etc/fonts/local.conf
# fontconfig skips a config it cannot parse and carries on, so check the result
# here: a broken one should fail the build, not quietly change every picture.
RUN test "$(fc-match -f '%{family[0]}' system-ui)" = "Inter" \
    && test "$(fc-match -f '%{family[0]}' Georgia)" = "Noto Serif" \
    && test "$(fc-match -f '%{family[0]}' monospace)" = "Liberation Mono"

COPY src /app/src
COPY --from=bundles /build/src/visualizer/akasha/static/studio /app/src/visualizer/akasha/static/studio
COPY --from=bundles /build/src/visualizer/logos/static/writer /app/src/visualizer/logos/static/writer
COPY --from=bundles /build/src/visualizer/chronos/static/workspace /app/src/visualizer/chronos/static/workspace
# The seeds, the smoke scripts and the runner. .dockerignore keeps docker/.env
# out of the build context, so the secret cannot reach this image.
COPY docker /app/docker

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src

CMD ["python", "/app/docker/shots.py"]
