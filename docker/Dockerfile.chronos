# Lightweight image for the chronos API (plotline & timeline service).
#
# Mirrors Dockerfile.akasha: same slim base, same layout, same layer
# ordering. Chronos always ships alongside akasha and shares its
# MongoDB (entities live there, and both use one `_auth` store), so the real
# differences are the gunicorn entrypoint and, like Akasha's and Logos's, a Node
# stage that compiles its one bundled page.
#
# Build context is the repo root (see docker-compose.nas.yml).

# The workspace's bundle, compiled from frontend/src/chronos (React +
# TypeScript, built by Vite). Node exists only in this stage: the image that
# runs gets the built files and nothing else.
FROM node:22-slim AS workspace
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# Vite writes into ../src/visualizer/chronos/static/workspace (vite.chronos.config.ts).
RUN npx vite build -c vite.chronos.config.ts

FROM python:3.11-slim

WORKDIR /app

# Install dependencies first so app-code edits don't invalidate this layer.
# requirements.txt includes networkx, which chronos uses for its story graph.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# The source tree is copied under /app/src so the package imports as
# `visualizer.chronos` (see PYTHONPATH below).
COPY src /app/src
COPY --from=workspace /build/src/visualizer/chronos/static/workspace /app/src/visualizer/chronos/static/workspace

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    MONGO_URI=mongodb://mongo:27017

EXPOSE 5000

# Threaded (gthread) workers handle idle browser keep-alive connections
# gracefully; the default sync worker kills the whole worker on its request
# timeout, which surfaces to the client as a transient 500. A 60s timeout gives
# slow requests headroom.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", \
     "--workers", "2", "--worker-class", "gthread", "--threads", "4", \
     "--timeout", "60", "visualizer.chronos.wsgi:app"]
