# Lightweight image for the prithvi API (SVG maps and their pins).
#
# Mirrors Dockerfile.akasha and Dockerfile.chronos: same slim base, same layout,
# same layer ordering. Prithvi always ships alongside akasha and reads it
# in-process (an article has to exist before a pin can name it), so the only
# real difference is the gunicorn entrypoint.
#
# Build context is the repo root (see docker-compose.nas.yml).
FROM python:3.11-slim

WORKDIR /app

# Install dependencies first so app-code edits don't invalidate this layer.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# The source tree is copied under /app/src so the package imports as
# `visualizer.prithvi` (see PYTHONPATH below).
COPY src /app/src

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    MONGO_URI=mongodb://mongo:27017

EXPOSE 5000

# Threaded (gthread) workers, as in the sibling images. A map upload is a few
# megabytes of body and a full XML rewrite, so the 60s timeout matters more here
# than it does for a JSON API.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", \
     "--workers", "2", "--worker-class", "gthread", "--threads", "4", \
     "--timeout", "60", "visualizer.prithvi.wsgi:app"]
