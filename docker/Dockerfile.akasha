# Lightweight image for akasha (the article store).
# Ideal for constrained hosts like a Synology NAS: small, quick to build, and it
# installs only what the app needs.
#
# Build context is the repo root (see docker-compose.nas.yml).

# The research studio's bundle, compiled from frontend/ (React + TypeScript +
# Vite). Node exists only in this stage: the image that runs gets the built
# files and nothing else, and loads nothing from a CDN at run time.
FROM node:22-slim AS studio
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# Vite writes into ../src/visualizer/akasha/static/studio (see vite.config.ts).
RUN npm run build

FROM python:3.11-slim

WORKDIR /app

# Install dependencies first so app-code edits don't invalidate this layer.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# The source tree is copied under /app/src so the package imports as
# `visualizer.akasha` (see PYTHONPATH below).
COPY src /app/src
COPY --from=studio /build/src/visualizer/akasha/static/studio /app/src/visualizer/akasha/static/studio

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    MONGO_URI=mongodb://mongo:27017

EXPOSE 5000

# Threaded (gthread) workers handle idle browser keep-alive connections
# gracefully; the default sync worker kills the whole worker on its request
# timeout, which surfaces to the client as a transient 500. A 60s timeout gives
# slow requests headroom.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", \
     "--workers", "2", "--worker-class", "gthread", "--threads", "4", \
     "--timeout", "60", "visualizer.akasha.wsgi:app"]
