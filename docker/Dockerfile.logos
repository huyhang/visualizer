# Lightweight image for logos: the manuscript reader and the API behind it.
#
# Mirrors its three siblings: same slim base, same layout, same layer ordering.
# Logos always ships alongside chronos and akasha and reads both in-process (a
# book has to exist before a manuscript can hang off it), so the real
# differences are the gunicorn entrypoint and, like Akasha's, a Node stage that
# compiles its one bundled page.
#
# Build context is the repo root (see docker-compose.nas.yml).

# The writing page's bundle, compiled from frontend/src/logos (React +
# TypeScript + Tiptap, built by Vite). Node exists only in this stage, as in
# Akasha's image: the image that runs gets the built files and nothing else.
FROM node:22-slim AS writer
WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
# Vite writes into ../src/visualizer/logos/static/writer (vite.logos.config.ts).
RUN npx vite build -c vite.logos.config.ts

FROM python:3.11-slim

WORKDIR /app

# Native text shaping for WeasyPrint, plus a metric-compatible serif: with no
# font package the image ships only DejaVu, so the print stylesheet's Times
# would silently resolve to a wider face and shift every line break.
RUN apt-get update && apt-get install -y --no-install-recommends \
    libpango-1.0-0 libpangoft2-1.0-0 libharfbuzz-subset0 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies first so app-code edits don't invalidate this layer.
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# The source tree is copied under /app/src so the package imports as
# `visualizer.logos` (see PYTHONPATH below).
COPY src /app/src
COPY --from=writer /build/src/visualizer/logos/static/writer /app/src/visualizer/logos/static/writer

ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/src \
    MONGO_URI=mongodb://mongo:27017

EXPOSE 5000

# Threaded (gthread) workers, as in the sibling images. A section PUT carries a
# whole chapter of rich text, so the 60s timeout is worth keeping here too.
CMD ["gunicorn", "--bind", "0.0.0.0:5000", \
     "--workers", "2", "--worker-class", "gthread", "--threads", "4", \
     "--timeout", "60", "visualizer.logos.wsgi:app"]
