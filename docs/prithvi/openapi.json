        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "An Akasha database. Map permissions are this database's permissions."
      },
      "MapName": {
        "name": "map_name",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "1-128 letters, digits, dots, underscores or hyphens."
      },
      "Collection": {
        "name": "collection",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "The Akasha collection the pinned article lives in."
      },
      "Article": {
        "name": "article",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "The pinned article's id. This, with the map, is the pin's identity."
      },
      "Rev": {
        "name": "rev",
        "in": "path",
        "required": true,
        "schema": {
          "type": "integer"
        },
        "description": "A retained revision number."
      },
      "Page": {
        "name": "page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "default": 1
        },
        "description": "Clamped into range rather than refused."
      },
      "PerPage": {
        "name": "per_page",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        },
        "description": "Clamped to at most 100."
      },
      "IfMatch": {
        "name": "If-Match",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string"
        },
        "description": "The revision you read, e.g. `\"3\"`. Required on every change.",
        "example": "\"3\""
      }
    },
    "requestBodies": {
      "SvgUpload": {
        "required": true,
        "description": "The drawing itself, as a raw body.",
        "content": {
          "image/svg+xml": {
            "schema": {
              "type": "string"
            },
            "example": "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1200 720\"/>"
          }
        }
      },
      "PositionBody": {
        "required": true,
        "description": "Exactly x and y, in viewBox units.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Position"
            }
          }
        }
      },
      "ScaleBody": {
        "required": true,
        "description": "How far across the map is.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Scale"
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "The request is malformed",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "No session",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Your Akasha grants do not reach this world or article",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "NotFound": {
        "description": "No such world, map, pin or retained revision",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Conflict": {
        "description": "The name is taken, your revision is stale, or the viewBox is locked",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "TooLarge": {
        "description": "The upload is over the configured cap",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "UnsupportedMediaType": {
        "description": "An SVG upload arrived as something else",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Unprocessable": {
        "description": "Well formed, but the world disagrees",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "PreconditionRequired": {
        "description": "This change needs an If-Match header",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "headers": {
      "ETag": {
        "description": "The revision this response is at.",
        "schema": {
          "type": "string"
        },
        "example": "\"3\""
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status",
          "service"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "service": {
            "type": "string"
          }
        },
        "example": {
          "status": "ok",
          "service": "prithvi"
        }
      },
      "ViewBox": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 4,
        "maxItems": 4,
        "description": "min-x, min-y, width, height, in the drawing's own units",
        "example": [
          0,
          0,
          1200,
          720
        ]
      },
      "Scale": {
        "type": "object",
        "required": [
          "across",
          "unit"
        ],
        "description": "How far the viewBox width spans in the world's own units.",
        "properties": {
          "across": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "unit": {
            "type": "string",
            "maxLength": 32
          }
        },
        "example": {
          "across": 400,
          "unit": "leagues"
        }
      },
      "Sanitization": {
        "type": "object",
        "required": [
          "removed_elements",
          "removed_attributes"
        ],
        "description": "What the sanitizer took out of the upload, and how often.",
        "properties": {
          "removed_elements": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          },
          "removed_attributes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            }
          }
        },
        "example": {
          "removed_elements": {
            "script": 1
          },
          "removed_attributes": {
            "onclick": 2
          }
        }
      },
      "Position": {
        "type": "object",
        "required": [
          "x",
          "y"
        ],
        "additionalProperties": false,
        "description": "A point in the map's own viewBox units.",
        "properties": {
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          }
        },
        "example": {
          "x": 355,
          "y": 215
        }
      },
      "Article": {
        "type": "object",
        "required": [
          "database",
          "collection",
          "id",
          "title",
          "status"
        ],
        "description": "The Akasha article a pin names, read at the moment of asking.",
        "properties": {
          "database": {
            "type": "string"
          },
          "collection": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "string",
            "enum": [
              "available",
              "missing"
            ]
          }
        },
        "example": {
          "database": "ember-pact",
          "collection": "locations",
          "id": "highkeep",
          "title": "Highkeep",
          "status": "available"
        }
      },
      "Map": {
        "type": "object",
        "required": [
          "world",
          "id",
          "rev",
          "view_box",
          "scale",
          "sanitization"
        ],
        "properties": {
          "world": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "rev": {
            "type": "integer"
          },
          "view_box": {
            "$ref": "#/components/schemas/ViewBox"
          },
          "scale": {
            "$ref": "#/components/schemas/Scale",
            "nullable": true
          },
          "sanitization": {
            "$ref": "#/components/schemas/Sanitization"
          },
          "created_by": {
            "type": "string",
            "nullable": true
          },
          "updated_by": {
            "type": "string",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "nullable": true
          }
        },
        "example": {
          "world": "ember-pact",
          "id": "western-realms",
          "rev": 2,
          "view_box": [
            0,
            0,
            1200,
            720
          ],
          "scale": {
            "across": 400,
            "unit": "leagues"
          },
          "sanitization": {
            "removed_elements": {
              "script": 1
            },
            "removed_attributes": {}
          },
          "created_by": "mara",
          "updated_by": "mara",
          "updated_at": "2026-01-01T00:00:00+00:00"
        }
      },
      "MapPage": {
        "type": "object",
        "required": [
          "maps",
          "page",
          "per_page",
          "total",
          "pages"
        ],
        "properties": {
          "maps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Map"
            }
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          }
        },
        "example": {
          "maps": [
            {
              "world": "ember-pact",
              "id": "western-realms",
              "rev": 2,
              "view_box": [
                0,
                0,
                1200,
                720
              ],
              "scale": {
                "across": 400,
                "unit": "leagues"
              },
              "sanitization": {
                "removed_elements": {
                  "script": 1
                },
                "removed_attributes": {}
              },
              "created_by": "mara",
              "updated_by": "mara",
              "updated_at": "2026-01-01T00:00:00+00:00"
            }
          ],
          "page": 1,
          "per_page": 25,
          "total": 1,
          "pages": 1
        }
      },
      "Pin": {
        "type": "object",
        "required": [
          "world",
          "map",
          "article",
          "position",
          "rev"
        ],
        "properties": {
          "world": {
            "type": "string"
          },
          "map": {
            "type": "string"
          },
          "article": {
            "$ref": "#/components/schemas/Article"
          },
          "position": {
            "$ref": "#/components/schemas/Position"
          },
          "rev": {
            "type": "integer"
          },
          "created_by": {
            "type": "string",
            "nullable": true
          },
          "updated_by": {
            "type": "string",
            "nullable": true
          },
          "updated_at": {
            "type": "string",
            "nullable": true
          }
        },
        "example": {
          "world": "ember-pact",
          "map": "western-realms",
          "article": {
            "database": "ember-pact",
            "collection": "locations",
            "id": "highkeep",
            "title": "Highkeep",
            "status": "available"
          },
          "position": {
            "x": 355,
            "y": 215
          },
          "rev": 1,
          "created_by": "mara",
          "updated_by": "mara",
          "updated_at": "2026-01-01T00:00:00+00:00"
        }
      },
      "PinPage": {
        "type": "object",
        "required": [
          "pins",
          "page",
          "per_page",
          "total",
          "pages"
        ],
        "properties": {
          "pins": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Pin"
            }
          },
          "page": {
            "type": "integer"
          },
          "per_page": {
            "type": "integer"
          },
          "total": {
            "type": "integer"
          },
          "pages": {
            "type": "integer"
          }
        },
        "example": {
          "pins": [
            {
              "world": "ember-pact",
              "map": "western-realms",
              "article": {
                "database": "ember-pact",
                "collection": "locations",
                "id": "highkeep",
                "title": "Highkeep",
                "status": "available"
              },
              "position": {
                "x": 355,
                "y": 215
              },
              "rev": 1,
              "created_by": "mara",
              "updated_by": "mara",
              "updated_at": "2026-01-01T00:00:00+00:00"
            }
          ],
          "page": 1,
          "per_page": 25,
          "total": 1,
          "pages": 1
        }
      },
      "VersionEntry": {
        "type": "object",
        "required": [
          "rev",
          "op",
          "author",
          "timestamp",
          "deleted"
        ],
        "properties": {
          "rev": {
            "type": "integer"
          },
          "op": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete",
              "restore"
            ]
          },
          "author": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          }
        },
        "example": {
          "rev": 2,
          "op": "update",
          "author": "mara",
          "timestamp": "2026-01-01T00:00:00+00:00",
          "deleted": false
        }
      },
      "VersionList": {
        "type": "object",
        "required": [
          "versions"
        ],
        "properties": {
          "versions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/VersionEntry"
            }
          }
        },
        "example": {
          "versions": [
            {
              "rev": 2,
              "op": "update",
              "author": "mara",
              "timestamp": "2026-01-01T00:00:00+00:00",
              "deleted": false
            }
          ]
        }
      },
      "MapVersion": {
        "type": "object",
        "required": [
          "world",
          "id",
          "rev",
          "op",
          "author",
          "timestamp",
          "deleted"
        ],
        "description": "A retained map revision. The drawing is not included; restore it to see it.",
        "properties": {
          "world": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "rev": {
            "type": "integer"
          },
          "op": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete",
              "restore"
            ]
          },
          "author": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          },
          "view_box": {
            "$ref": "#/components/schemas/ViewBox"
          },
          "scale": {
            "$ref": "#/components/schemas/Scale",
            "nullable": true
          }
        },
        "example": {
          "world": "ember-pact",
          "id": "western-realms",
          "rev": 2,
          "op": "update",
          "author": "mara",
          "timestamp": "2026-01-01T00:00:00+00:00",
          "deleted": false,
          "view_box": [
            0,
            0,
            1200,
            720
          ],
          "scale": null
        }
      },
      "PinVersion": {
        "type": "object",
        "required": [
          "world",
          "map",
          "article",
          "position",
          "rev",
          "op",
          "author",
          "timestamp",
          "deleted"
        ],
        "properties": {
          "world": {
            "type": "string"
          },
          "map": {
            "type": "string"
          },
          "article": {
            "$ref": "#/components/schemas/Article"
          },
          "position": {
            "$ref": "#/components/schemas/Position",
            "nullable": true
          },
          "rev": {
            "type": "integer"
          },
          "op": {
            "type": "string",
            "enum": [
              "create",
              "update",
              "delete",
              "restore"
            ]
          },
          "author": {
            "type": "string",
            "nullable": true
          },
          "timestamp": {
            "type": "string"
          },
          "deleted": {
            "type": "boolean"
          }
        },
        "example": {
          "world": "ember-pact",
          "map": "western-realms",
          "article": {
            "database": "ember-pact",
            "collection": "locations",
            "id": "highkeep",
            "title": "Highkeep",
            "status": "available"
          },
          "position": {
            "x": 355,
            "y": 215
          },
          "rev": 2,
          "op": "update",
          "author": "mara",
          "timestamp": "2026-01-01T00:00:00+00:00",
          "deleted": false
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "description": "Every failure. `code` is stable; `error` is prose and may change.",
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "PRITHVI_ERROR",
              "INVALID_WORLD",
              "INVALID_MAP_NAME",
              "INVALID_ARTICLE_ADDRESS",
              "INVALID_SVG",
              "INVALID_POSITION",
              "INVALID_SCALE",
              "INVALID_REVISION",
              "UNSUPPORTED_MEDIA_TYPE",
              "SVG_TOO_LARGE",
              "PRECONDITION_REQUIRED",
              "POSITION_OUT_OF_BOUNDS",
              "ARTICLE_NOT_FOUND",
              "WORLD_NOT_FOUND",
              "MAP_NOT_FOUND",
              "PIN_NOT_FOUND",
              "REVISION_NOT_RETAINED",
              "ALREADY_EXISTS",
              "REVISION_CONFLICT",
              "VIEWBOX_LOCKED",
              "FORBIDDEN"
            ]
          },
          "evidence": {
            "type": "object"
          }
        },
        "example": {
          "error": "A pin must sit inside its map's viewBox.",
          "code": "POSITION_OUT_OF_BOUNDS",
          "evidence": {
            "position": {
              "x": 900,
              "y": 10
            },
            "view_box": [
              0,
              0,
              1200,
              720
            ]
          }
        }
      }
    }
  }
}
