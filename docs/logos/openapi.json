      "LinkedScene": {
        "type": "object",
        "required": ["id", "title", "when", "missing"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string", "description": "The scene's Chronos title, or its id when it has none." },
          "when": { "type": "string", "description": "The scene's timeframe in this book's own calendar; empty when the scene is missing." },
          "missing": { "type": "boolean", "description": "True when the section still names this scene but Chronos no longer has it." }
        },
        "example": { "id": "opening", "title": "The gate opens", "when": "Day 5 – Day 7", "missing": false }
