{
  "name": "visualizer-frontend",
  "private": true,
  "version": "0.1.0",
  "description": "Visualizer's compiled browser surfaces: Akasha's research studio, Logos's writing page and Chronos's workspace, built into each app's static folder and served by Flask.",
  "type": "module",
  "scripts": {
    "build": "vite build && vite build -c vite.logos.config.ts && vite build -c vite.chronos.config.ts",
    "watch": "vite build --watch --mode development",
    "watch:logos": "vite build -c vite.logos.config.ts --watch --mode development",
    "watch:chronos": "vite build -c vite.chronos.config.ts --watch --mode development",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p .",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
